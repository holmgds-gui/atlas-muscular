// Regras do banco de dados (Firestore) do Muscle Atlas — cópia para consulta.
// As regras que valem são as publicadas no console do Firebase (projeto muscle-atlas-e1a56 › Firestore › Regras).
// Se mudar o sync.js (campos ou coleções novas), mude lá também e atualize esta cópia.
//
// O que elas garantem:
//  - ninguém sem login lê nem escreve nada;
//  - cada pessoa só lê e escreve dentro de users/<o próprio id>;
//  - só existem as coleções w (treinos feitos), p (Meus treinos) e k (peso/ajustes/conquistas);
//  - cada documento só tem os campos d (texto JSON, até 500 mil caracteres, ou null = apagado) e t (hora do servidor),
//    então não dá para encher o banco com outros dados nem falsificar a hora.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{col}/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && col in ['w', 'p', 'k']
        && request.resource.data.keys().hasOnly(['d', 't'])
        && (request.resource.data.d == null
            || (request.resource.data.d is string && request.resource.data.d.size() < 500000))
        && request.resource.data.t == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // todo o resto: fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
